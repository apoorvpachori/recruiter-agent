# Fireworks AI model configuration
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
# Or try a current GLM model ID offered by your Fireworks account, for example:
# FIREWORKS_MODEL=accounts/fireworks/models/glm-4p5-air

# Brave Search API (provider-neutral search tool; add the key to local .env)
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/llm/context

# LangSmith tracing is opt-in. Traces can include prompts and model outputs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recruiter-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=recruiter-agent
LANGSMITH_AGENT_ENVIRONMENT=local
